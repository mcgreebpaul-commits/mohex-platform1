# Example frontend environment variables (do NOT commit real secrets)
# Copy this file to .env locally and fill in real values for local testing.
# Do NOT commit your .env file to the repository.
# shellcheck shell=sh
# shellcheck disable=SC2034
# Backend API base URL (use your Heroku backend or your production API)
NEXT_PUBLIC_API_BASE_URL=https://api.mohex.org

# Pipedream agent webhooks (example)
NEXT_PUBLIC_PIPEDREAM_TRADE_COPILOT_URL=https://eoj65e7xlqgvuuo.m.pipedream.net
NEXT_PUBLIC_PIPEDREAM_MARKET_ANALYST_URL=https://eozbl198ek1uo44.m.pipedream.net
NEXT_PUBLIC_PIPEDREAM_PORTFOLIO_BUILDER_URL=https://eoalkfm9c1mgc4b.m.pipedream.net
NEXT_PUBLIC_PIPEDREAM_TRENDSPOTTER_URL=https://eouue2p5djiewtr.m.pipedream.net
NEXT_PUBLIC_PIPEDREAM_RISK_MANAGER_URL=https://eoxx3em8sfjeut3.m.pipedream.net

# Third-party keys
NEXT_PUBLIC_SMARTSUPP_KEY=your-smartsupp-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# When deploying to Netlify:
# - Set NEXT_PUBLIC_API_BASE_URL in Netlify's Site > Settings > Build & deploy > Environment to your backend URL (e.g. https://api.mohex.org)
# - Do NOT commit real secrets to the repository; keep sensitive keys in Netlify environment variables.