{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "esnext",
    "lib": ["esnext"],
  "types": ["node", "express", "cors", "jsonwebtoken", "bcryptjs", "socket.io"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "moduleResolution": "nodenext"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}